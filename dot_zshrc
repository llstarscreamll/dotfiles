# Homebrew (Apple Silicon / Intel)
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Completions (zsh built-ins + Homebrew's site-functions)
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select

# mise (runtimes & tools)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Default editor (also used by git)
export EDITOR=nvim
export VISUAL=nvim

# hunk: Catppuccin Latte/Mocha following the macOS appearance
hunk() {
  local theme=catppuccin-latte
  [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == Dark ]] && theme=catppuccin-mocha
  command hunk --theme "$theme" "$@"
}

# Starship prompt (keep last)
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
