# Loaded by interactive shells.

# Completions (zsh built-ins + Homebrew's site-functions)
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select

# mise (runtimes & tools)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Functions: one file per function, loaded on first use
fpath=(~/.config/zsh/functions $fpath)
autoload -Uz ~/.config/zsh/functions/*(N:t)

# Aliases
[[ -r ~/.config/zsh/aliases.zsh ]] && source ~/.config/zsh/aliases.zsh

# zoxide: cd also jumps by partial name; cdi picks interactively
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd cd)"
fi

# Machine-specific settings, not tracked in dotfiles
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local

# Starship prompt (keep last)
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
