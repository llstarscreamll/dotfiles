# Loaded by interactive shells.

# Completions (zsh built-ins + Homebrew's site-functions)
# Full check (~200 ms) only when the dump is missing or older than a day;
# otherwise load the cached ~/.zcompdump (-C, ~7 ms)
autoload -Uz compinit
zcompdump_stale=(~/.zcompdump(N.mh+24))
if [[ ! -e ~/.zcompdump || -n $zcompdump_stale ]]; then
  compinit
  touch ~/.zcompdump  # compinit only rewrites it when completions change
else
  compinit -C
fi
unset zcompdump_stale
zstyle ':completion:*' menu select
# Case-insensitive matching: lowercase also matches uppercase, and vice versa
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Emacs-style line editing (zsh would pick vi mode because EDITOR=nvim)
bindkey -e

# History: large, shared live across terminals, no duplicates;
# commands starting with a space are not saved
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# Keep trivial commands out of the saved history
# (still recallable with Up until the next command runs)
zshaddhistory() {
  local line=${1%%$'\n'}
  [[ $line != (ls|l|ll|la|lt)(| *) &&
     $line != (c|clear|q|exit|pwd|history|fg|bg|jobs) &&
     $line != cd(| ..| -| \~) ]]
}

# Up/Down search history for commands starting with what's typed
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# mise (runtimes & tools)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Functions: one file per function, loaded on first use
fpath=(~/.config/zsh/functions $fpath)
autoload -Uz ~/.config/zsh/functions/*(N:t)

# fzf: Ctrl-R history, Ctrl-T files, Alt-C cd
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# Aliases
[[ -r ~/.config/zsh/aliases.zsh ]] && source ~/.config/zsh/aliases.zsh

# zoxide: cd also jumps by partial name; cdi picks interactively
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd cd)"
fi

# Fish-like suggestions from history (accept with Right arrow)
if [[ -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# Machine-specific settings, not tracked in dotfiles
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local

# Starship prompt (keep last)
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
