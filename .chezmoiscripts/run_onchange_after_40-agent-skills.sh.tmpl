{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

{{ template "brew-env" . }}

# Skillfile is embedded so this script re-runs whenever skills change.
while read -r source skill; do
  [[ -z "$source" || "$source" == \#* ]] && continue
  mise exec node@24 -- npx -y skills@latest add "$source" \
    -g -a claude-code cursor opencode -s "$skill" -y </dev/null
done <<'SKILLFILE'
{{ include "Skillfile" -}}
SKILLFILE
{{- end -}}
