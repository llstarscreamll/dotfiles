{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Homebrew shellenv (needed in non-interactive chezmoi runs)
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# AWS core skills + AWS MCP server (needs uvx) for every detected agent.
# Update skills later with: aws agent-toolkit update-skill --all
mise exec awscli uv -- aws configure agent-toolkit --yes --region us-east-1 </dev/null
{{- end -}}
