# hunk: Catppuccin Latte/Mocha following the macOS appearance
local theme=catppuccin-latte
[[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == Dark ]] && theme=catppuccin-mocha
# --theme is a subcommand option, so it goes after the review subcommand.
case "$1" in
  open|diff|show|log|gh|patch|pager|difftool)
    command hunk "$1" --theme "$theme" "${@:2}" ;;
  stash)
    command hunk "$1" "$2" --theme "$theme" "${@:3}" ;;
  *)
    command hunk "$@" ;;
esac
