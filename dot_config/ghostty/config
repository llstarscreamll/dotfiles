# Theme — follows macOS light/dark appearance
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
window-theme = system

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# Window
confirm-close-surface = false
resize-overlay = never

# Cursor
cursor-style = block
cursor-style-blink = false
