# Theme — follows macOS light/dark appearance
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
window-theme = system

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# Window
confirm-close-surface = false
resize-overlay = never

# Cursor — blinking underline; orange stands out on Mocha and Latte
cursor-style = underline
cursor-style-blink = true
cursor-color = #fe640b
adjust-cursor-thickness = 2
# Keep shell integration from forcing a bar cursor at the prompt
shell-integration-features = no-cursor

# Left Option sends Alt (nvim/shell bindings); right Option still types
# layout characters like @, \ and | and accent dead keys
macos-option-as-alt = left
